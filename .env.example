# ── Telegram ──────────────────────────────────────────────
API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=+628xxxxxxxxxx

# ── Google Gemini ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ── Database (Railway PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Auto-reply Settings ────────────────────────────────────
IDLE_TIMEOUT=300          # Detik sebelum dianggap idle (default 5 menit)
REPLY_DELAY=3             # Jeda sebelum balas (biar natural)
HISTORY_LIMIT=10          # Jumlah pesan riwayat yang dikirim ke AI

# ── Whitelist / Blacklist ──────────────────────────────────
WHITELIST_ENABLED=false   # true = hanya balas kontak di whitelist
WHITELIST_IDS=            # Pisahkan dengan koma: 123456,789012
BLACKLIST_IDS=            # Pisahkan dengan koma: 123456,789012
