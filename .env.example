# ── Telegram API (dari my.telegram.org) ───────────────────
API_ID=your_api_id
API_HASH=your_api_hash

# ── Bot Token (dari @BotFather) ────────────────────────────
BOT_TOKEN=your_bot_token

# ── Owner ID (Telegram user ID kamu) ──────────────────────
# Cara cek: forward pesan ke @userinfobot
OWNER_ID=your_telegram_user_id

# ── Log Channel ──────────────────────────────────────────────
# Channel ID (contoh: -1001234567890) atau username (contoh: @namalog)
# Kosongkan jika tidak ingin log dikirim ke channel
LOG_CHANNEL=-1001234567890

# ── Google Gemini ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ── Database (Railway PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Auto-reply Settings ────────────────────────────────────
IDLE_TIMEOUT=300          # Detik idle sebelum bot aktif (default 5 menit)
REPLY_DELAY=3             # Jeda sebelum balas (biar natural)
HISTORY_LIMIT=10          # Jumlah riwayat chat yang dikirim ke AI

# ── Whitelist / Blacklist ──────────────────────────────────
WHITELIST_ENABLED=false   # true = hanya balas kontak di whitelist
WHITELIST_IDS=            # Pisahkan dengan koma: 123456,789012
BLACKLIST_IDS=            # Pisahkan dengan koma: 123456,789012
